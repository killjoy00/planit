generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope              String?
  id_token           String? @db.Text
  session_state      String?
  user               User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  @@unique([identifier, token])
}

model User {
  id                  String            @id @default(cuid())
  name                String?
  email               String?           @unique
  emailVerified       DateTime?
  image               String?
  accounts            Account[]
  sessions            Session[]
  groups              Group[]
  polls               Poll[]
  series              RecurringSeries[]
  acquisitionSource   String?
  acquisitionCampaign String?
  acquisitionUseCase  String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  @@index([acquisitionSource, acquisitionCampaign])
  @@index([acquisitionUseCase])
}

model Group {
  id        String        @id @default(cuid())
  name      String
  creatorId String
  creator   User          @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  members   GroupMember[]
  polls     Poll[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model GroupMember {
  id        String   @id @default(cuid())
  groupId   String
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  name      String
  email     String
  createdAt DateTime @default(now())
  @@unique([groupId, email])
}

model RecurringSeries {
  id        String             @id @default(cuid())
  creatorId String
  creator   User               @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  cadence   RecurrenceCadence
  interval  Int                @default(1)
  active    Boolean            @default(true)
  polls     Poll[]
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  @@index([creatorId, active])
}

enum RecurrenceCadence {
  WEEKLY
  MONTHLY
}

model Poll {
  id                  String        @id @default(cuid())
  title               String
  description         String?       @db.Text
  type                PollType
  timeZone            String?
  status              PollStatus    @default(OPEN)
  creatorId           String
  creator             User          @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  groupId             String?
  group               Group?        @relation(fields: [groupId], references: [id], onDelete: SetNull)
  options             PollOption[]
  participants        Participant[]
  joinRequests        JoinRequest[]
  deadline            DateTime?
  threshold           Int?
  allowSuggestions    Boolean       @default(false)
  replyToCreator      Boolean       @default(false)
  finalLocation       String?
  finalNotes          String?       @db.Text
  shareToken          String?       @unique @default(cuid())
  reminderLevel       Int           @default(0)
  reminderSchedule    ReminderSchedule @default(AFTER_SEND)
  lastReminderAt      DateTime?
  winnerId            String?
  winner              PollOption?   @relation("PollWinner", fields: [winnerId], references: [id], onDelete: SetNull)
  votes               Vote[]
  seriesId            String?
  series              RecurringSeries? @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  seriesSequence      Int?
  acquisitionSource   String?
  acquisitionCampaign String?
  acquisitionUseCase  String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  @@unique([seriesId, seriesSequence])
  @@index([acquisitionSource, acquisitionCampaign])
  @@index([acquisitionUseCase])
}

enum PollType {
  DATE_POLL
  TIME_POLL
  SINGLE_CHOICE
  YES_NO_VETO
}

enum PollStatus {
  OPEN
  CLOSED
  CANCELLED
}

enum ReminderSchedule {
  AFTER_SEND
  BEFORE_DEADLINE
}

model PollOption {
  id              String     @id @default(cuid())
  pollId          String
  poll            Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  label           String
  dateValue       DateTime?
  endDate         DateTime?
  suggestedByName String?
  order           Int        @default(0)
  votes           Vote[]
  wonPolls        Poll[]     @relation("PollWinner")
  createdAt       DateTime   @default(now())
}

model Participant {
  id           String    @id @default(cuid())
  pollId       String
  poll         Poll      @relation(fields: [pollId], references: [id], onDelete: Cascade)
  name         String
  email        String
  token        String    @unique @default(cuid())
  tokenUsed    Boolean   @default(false)
  votedAt      DateTime?
  optedOut     Boolean   @default(false)
  inviteSentAt DateTime?
  inviteError  String?   @db.Text
  resultSentAt DateTime?
  resultError  String?   @db.Text
  votes        Vote[]
  createdAt    DateTime  @default(now())
  @@unique([pollId, email])
}

model Vote {
  id            String      @id @default(cuid())
  participantId String
  participant   Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  pollId        String
  poll          Poll        @relation(fields: [pollId], references: [id], onDelete: Cascade)
  optionId      String?
  option        PollOption? @relation(fields: [optionId], references: [id], onDelete: SetNull)
  choice        VoteChoice?
  preference    VotePreference?
  createdAt     DateTime    @default(now())
  @@unique([participantId, optionId])
}

enum VoteChoice {
  YES
  FINE
  NO
}

enum VotePreference {
  IDEAL
  AVAILABLE
}

model JoinRequest {
  id         String   @id @default(cuid())
  pollId     String
  poll       Poll     @relation(fields: [pollId], references: [id], onDelete: Cascade)
  name       String
  email      String
  token      String   @unique @default(cuid())
  expires    DateTime
  lastSentAt DateTime @default(now())
  createdAt  DateTime @default(now())
  @@unique([pollId, email])
}

model EmailSendAttempt {
  id        String   @id @default(cuid())
  purpose   EmailSendPurpose @default(SIGN_IN)
  email     String
  ip        String?
  scope     String?
  createdAt DateTime @default(now())
  @@index([purpose, email, createdAt])
  @@index([purpose, ip, createdAt])
  @@index([purpose, scope, createdAt])
  @@map("SignInAttempt")
}

enum EmailSendPurpose {
  SIGN_IN
  JOIN
}

model EmailSuppression {
  id        String   @id @default(cuid())
  email     String   @unique
  reason    String?
  createdAt DateTime @default(now())
}
