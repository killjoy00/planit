generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ── NextAuth tables ──────────────────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ── Creator user ─────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  groups        Group[]
  polls         Poll[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// ── Persistent friend groups ─────────────────────────────────────────────────

model Group {
  id        String        @id @default(cuid())
  name      String
  creatorId String
  creator   User          @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  members   GroupMember[]
  polls     Poll[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model GroupMember {
  id        String   @id @default(cuid())
  groupId   String
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  name      String
  email     String
  createdAt DateTime @default(now())

  @@unique([groupId, email])
}

// ── Polls ────────────────────────────────────────────────────────────────────

model Poll {
  id             String        @id @default(cuid())
  title          String
  description    String?       @db.Text
  type           PollType
  status         PollStatus    @default(OPEN)
  creatorId      String
  creator        User          @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  groupId        String?
  group          Group?        @relation(fields: [groupId], references: [id], onDelete: SetNull)
  options        PollOption[]
  participants   Participant[]
  joinRequests   JoinRequest[]
  deadline          DateTime?
  threshold         Int?
  allowSuggestions  Boolean       @default(false)
  /// Put the creator's address in Reply-To, so invitees can answer a person
  /// rather than a no-reply mailbox. Off unless the creator asks for it — it
  /// shows their address to everyone on the guest list.
  replyToCreator    Boolean       @default(false)
  /// One link the creator can hand out themselves — group chat, SMS, anywhere.
  /// Null on polls created before share links existed; minted on first view.
  /// Unlike a participant token this is public, so it grants nothing on its
  /// own: it opens a join form, and a vote link is only issued to an address
  /// that proved it can receive mail.
  shareToken        String?       @unique @default(cuid())
  reminderLevel     Int           @default(0)
  /// Whether nudges are timed from when the poll went out or from when the
  /// answer is needed. See `lib/reminder-schedule.ts`.
  reminderSchedule  ReminderSchedule @default(AFTER_SEND)
  lastReminderAt DateTime?
  winnerId       String?
  winner         PollOption?   @relation("PollWinner", fields: [winnerId], references: [id], onDelete: SetNull)
  votes          Vote[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

enum PollType {
  DATE_POLL
  SINGLE_CHOICE
  YES_NO_VETO
}

enum PollStatus {
  OPEN
  CLOSED
  CANCELLED
}

/// When to chase the people who haven't answered.
///
/// `AFTER_SEND` counts from the moment the invitations went out, which is the
/// only thing to count from when a poll has no deadline. `BEFORE_DEADLINE`
/// counts back from the moment the answer is actually needed — the nudge that
/// lands the day before is worth more than the one that lands because the poll
/// happens to be a day old.
enum ReminderSchedule {
  AFTER_SEND
  BEFORE_DEADLINE
}

// ── Poll options ─────────────────────────────────────────────────────────────

model PollOption {
  id        String     @id @default(cuid())
  pollId    String
  poll      Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  label            String
  dateValue        DateTime?
  endDate          DateTime?
  suggestedByName  String?
  order            Int       @default(0)
  votes     Vote[]
  wonPolls  Poll[]     @relation("PollWinner")
  createdAt DateTime   @default(now())
}

// ── Participants ─────────────────────────────────────────────────────────────

model Participant {
  id        String    @id @default(cuid())
  pollId    String
  poll      Poll      @relation(fields: [pollId], references: [id], onDelete: Cascade)
  name      String
  email     String
  token     String    @unique @default(cuid())
  tokenUsed Boolean   @default(false)
  votedAt   DateTime?
  optedOut  Boolean   @default(false)
  // Delivery of the invitation, as reported by the mail provider. Both null
  // means it has not been attempted; `inviteError` set means it was refused.
  inviteSentAt DateTime?
  inviteError  String?   @db.Text
  votes     Vote[]
  createdAt DateTime  @default(now())

  @@unique([pollId, email])
}

// ── Votes ────────────────────────────────────────────────────────────────────

/// One selection by one participant. A date poll records a row per date that
/// works for that person, so a participant may hold several; single-choice and
/// yes/no polls record exactly one. Uniqueness is per (participant, option)
/// rather than per participant — the latter is what allowed only one pick.
model Vote {
  id            String      @id @default(cuid())
  participantId String
  participant   Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  pollId        String
  poll          Poll        @relation(fields: [pollId], references: [id], onDelete: Cascade)
  optionId      String?
  option        PollOption? @relation(fields: [optionId], references: [id], onDelete: SetNull)
  choice        VoteChoice?
  createdAt     DateTime    @default(now())

  @@unique([participantId, optionId])
}

enum VoteChoice {
  YES
  FINE
  NO
}

// ── Self-service joins ───────────────────────────────────────────────────────

/// Someone who followed a share link and asked to join, but has not yet proved
/// the address is theirs.
///
/// Deliberately not a `Participant` yet. The share link is public, so anyone
/// who has it could otherwise pad a poll with addresses that never answer —
/// inflating "3 of 12 voted" and earning the sender a pile of unsolicited mail.
/// A row here becomes a participant only once its token comes back verified.
model JoinRequest {
  id        String   @id @default(cuid())
  pollId    String
  poll      Poll     @relation(fields: [pollId], references: [id], onDelete: Cascade)
  name      String
  email     String
  token     String   @unique @default(cuid())
  expires   DateTime
  /// When the verification mail last went out, so a refresh cannot be used to
  /// mailbomb one address through a public form.
  lastSentAt DateTime @default(now())
  createdAt DateTime @default(now())

  @@unique([pollId, email])
}

// ── Sign-in abuse control ────────────────────────────────────────────────────

/// One sign-in link we were asked to send, recorded so the public login form
/// cannot be used to mail a stranger repeatedly.
///
/// The form takes an address from anyone and sends mail to it — that is what a
/// magic link is — so without this it is an open relay for one specific
/// message. Address-bombing campaigns submit a victim's address to hundreds of
/// such forms at once to bury a real notification, and every one of those sends
/// costs the sending domain a little more of its reputation.
///
/// Deliberately not tied to `User`: most of these are addresses that have no
/// account and never will. Rows are disposable and pruned by the daily cron.
model SignInAttempt {
  id        String   @id @default(cuid())
  /// Always stored lowercased, as Auth.js normalises the address before this.
  email     String
  /// Best-effort client address, for capping one source that cycles addresses.
  /// Null when no forwarding header was present.
  ip        String?
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([ip, createdAt])
}

// ── Suppression ──────────────────────────────────────────────────────────────

/// Addresses that must never be mailed again, however they got here.
///
/// Distinct from `Participant.optedOut`, which means "count me out of this one
/// plan" and still lets a friend invite you to the next. This is the mail
/// client's One-Click unsubscribe and it is global and permanent: honouring it
/// exactly is what keeps complaint rates — and therefore inbox placement — low.
model EmailSuppression {
  id        String   @id @default(cuid())
  /// Always stored lowercased; compare case-insensitively.
  email     String   @unique
  reason    String?
  createdAt DateTime @default(now())
}
